# Cloudflare API Key (Bearer token with Zone.DNS edit permissions)
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here

# Main Domain on Cloudflare (e.g. example.com)
CLOUDFLARE_DOMAIN=example.com

# Specific Subdomain on the main domain (e.g. sub.example.com or example.com for root)
CLOUDFLARE_SUBDOMAIN=sub.example.com

# DNS Record Type (A or AAAA)
DNS_TYPE=A

# Whether the DNS record should be proxied through Cloudflare (true/false)
DNS_PROXIED=false

# Time interval in minutes between DNS update checks
TIME_TO_UPDATE_DNS=20

# Optional: Discord Webhook URL for status notifications
DISCORD_WEBHOOK_URL=

# Optional: Discord Bot Token & Channel ID (Alternative to Webhook)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
